# Enums
enum StatusObra {
  DISPONIBLE
  RESERVADA
  VENDIDA
}

enum StatusOrden {
  PENDIENTE
  CONCRETADA
  CANCELADA
}

# Types
type Preguntas {
  id: ID!
  id_cliente: ID!
  cliente: Cliente!
  pregunta: String!
  respuesta: String!
}

# Input Types
input NewPreguntas {
  id_cliente: ID!
  pregunta: String!
  respuesta: String!
}

input UpdatePreguntas {
  id: ID!
  id_cliente: ID
  pregunta: String
  respuesta: String
}

# Types
type TarjetaCliente {
  id_tarjeta: ID!
  id_cliente: ID!
  cliente: Cliente!
  numero_tarjeta: String!
  tipo: String!
}

# Input Types
input NewTarjetaCliente {
  id_cliente: ID!
  numero_tarjeta: String!
  tipo: String!
}

input UpdateTarjetaCliente {
  id_tarjeta: ID!
  id_cliente: ID
  numero_tarjeta: String
  tipo: String
}

# Types
type Membresia {
  id_membresia: ID!
  id_cliente: ID!
  cliente: Cliente!
  id_tarjeta: ID!
  tarjeta: TarjetaCliente!
  fecha: String!
}

# Input Types
input NewMembresia {
  id_cliente: ID!
  id_tarjeta: ID!
  fecha: String!
}

input UpdateMembresia {
  id_membresia: ID!
  id_cliente: ID
  id_tarjeta: ID
  fecha: String
}

# Types
type Cliente {
  id: ID!
  nombre: String!
  email: String!
  telefono: String!
  login: String!
  password: String!
  codigo_seguridad: String!
}

type Trabajador {
  id: ID!
  nombre: String!
  login: String!
  password: String!
  admin: Boolean!
}

type Artista {
  id: ID!
  nombre: String!
  fecha_nacimiento: String!
  nacionalidad: String!
  biografia: String!
  foto: String!
}

type Genero {
  id: ID!
  nombre: String!
}

type Obra {
  id: ID!
  nombre: String!
  id_artista: ID!
  artista: Artista!
  id_genero: ID!
  genero: Genero!
  precio: Int!
  fecha_creacion: String!
  status: StatusObra!
  foto: String!
  material: String!
  peso: Int!
  dimensiones: String!
}

type Orden {
  id: ID!
  id_obra: ID!
  obra: Obra!
  id_cliente: ID!
  cliente: Cliente!
  id_trabajador: ID!
  trabajador: Trabajador!
  fecha: String!
  status: StatusOrden!
}

type LoginResponseCliente {
  success: Boolean!
  id: ID
  nombre: String
}

type LoginResponseTrabajador {
  success: Boolean!
  id: ID
  nombre: String
  admin: Boolean
}

# Input Types
input NewCliente {
  nombre: String!
  email: String!
  telefono: String!
  login: String!
  password: String!
  codigo_seguridad: String!
}

input UpdateCliente {
  id: ID!
  nombre: String
  email: String
  telefono: String
  login: String
  password: String
  codigo_seguridad: String
}

input NewTrabajador {
  nombre: String!
  login: String!
  password: String!
  admin: Boolean!
}

input UpdateTrabajador {
  id: ID!
  nombre: String
  login: String
  password: String
  admin: Boolean
}

input NewArtista {
  nombre: String!
  fecha_nacimiento: String!
  nacionalidad: String!
  biografia: String!
  foto: String!
}

input UpdateArtista {
  id: ID!
  nombre: String
  fecha_nacimiento: String
  nacionalidad: String
  biografia: String
  foto: String
}

input NewGenero {
  nombre: String!
}

input UpdateGenero {
  id: ID!
  nombre: String
}

input NewObra {
  nombre: String!
  id_artista: ID!
  id_genero: ID!
  precio: Int!
  fecha_creacion: String!
  status: StatusObra!
  foto: String!
  material: String!
  peso: Int!
  dimensiones: String!
}

input UpdateObra {
  id: ID!
  nombre: String
  id_artista: ID
  id_genero: ID
  precio: Int
  fecha_creacion: String
  status: StatusObra
  foto: String
  material: String
  peso: Int
  dimensiones: String
}

input NewOrden {
  id_obra: ID!
  id_cliente: ID!
  id_trabajador: ID
  fecha: String!
  status: StatusOrden!
}

input UpdateOrden {
  id: ID!
  id_obra: ID
  id_cliente: ID
  id_trabajador: ID
  fecha: String
  status: StatusOrden
}

# Queries
type Query {
  Clientes(limit: Int, offset: Int): [Cliente!]!
  Artistas(limit: Int, offset: Int): [Artista!]!
  Trabajadores(limit: Int, offset: Int): [Trabajador!]!
  Obras(limit: Int, offset: Int): [Obra!]!
  Ordenes(limit: Int, offset: Int): [Orden!]!
  TarjetasCliente(limit: Int, offset: Int): [TarjetaCliente!]!
  Preguntas(limit: Int, offset: Int): [Preguntas!]!
  Membresias(limit: Int, offset: Int): [Membresia!]!
  findMembresia(id_membresia: ID!): Membresia
  findMembresiasByCliente(id_cliente: ID!): [Membresia!]!
  findMembresiasByTarjeta(id_tarjeta: ID!): [Membresia!]!
  findPreguntas(id: ID!): Preguntas
  findPreguntasByCliente(id_cliente: ID!): [Preguntas!]!
  findTarjetaCliente(id_tarjeta: ID!): TarjetaCliente
  findCliente(id: ID!): [Cliente!]!
  findTrabajador(id: ID!): [Trabajador!]!
  findObra(id: ID!): [Obra!]!
  findOrden(id: ID!): Orden
  findArtista(id: ID!): [Artista!]!
  getObra(id: ID!): Obra
  loginCliente(login: String!, password: String!): LoginResponseCliente!
  loginTrabajador(login: String!, password: String!): LoginResponseTrabajador!
}

# Mutations
type Mutation {
  createCliente(input: NewCliente!): Cliente!
  updateCliente(input: UpdateCliente!): Cliente!
  killCliente(id: ID!): Boolean!

  createTrabajador(input: NewTrabajador!): Trabajador!
  updateTrabajador(input: UpdateTrabajador!): Trabajador!
  killTrabajador(id: ID!): Boolean!

  createArtista(input: NewArtista!): Artista!
  updateArtista(input: UpdateArtista!): Artista!
  killArtista(id: ID!): Boolean!

  createGenero(nombre: String!): Genero!
  updateGenero(input: UpdateGenero!): Genero!
  killGenero(id: ID!): Boolean!

  createObra(input: NewObra!): Obra!
  updateObra(input: UpdateObra!): Obra!
  killObra(id: ID!): Boolean!

  createOrden(input: NewOrden!): Orden!
  updateOrden(input: UpdateOrden!): Orden!
  killOrden(id: ID!): Boolean!

  createTarjetaCliente(input: NewTarjetaCliente!): TarjetaCliente!
  updateTarjetaCliente(input: UpdateTarjetaCliente!): TarjetaCliente!
  killTarjetaCliente(id_tarjeta: ID!): Boolean!

  createPreguntas(input: NewPreguntas!): Preguntas!
  updatePreguntas(input: UpdatePreguntas!): Preguntas!
  killPreguntas(id: ID!): Boolean!

  createMembresia(input: NewMembresia!): Membresia!
  updateMembresia(input: UpdateMembresia!): Membresia!
  killMembresia(id_membresia: ID!): Boolean!
}