# Enums
enum StatusObra {
  DISPONIBLE
  RESERVADA
  VENDIDA
}

enum StatusOrden {
  PENDIENTE
  CONCRETADA
  CANCELADA
}

# Types
type Cliente {
  id: ID!
  nombre: String!
  email: String!
  telefono: String!
  login: String!
  password: String!
  codigo_seguridad: String!
}

type Trabajador {
  id: ID!
  nombre: String!
  login: String!
  password: String!
  admin: Boolean!
}

type Artista {
  id: ID!
  nombre: String!
  fecha_nacimiento: String!
  nacionalidad: String!
  biografia: String!
  foto: String!
}

type Genero {
  id: ID!
  nombre: String!
}

type Obra {
  id: ID!
  nombre: String!
  id_artista: ID!
  artista: Artista!
  id_genero: ID!
  genero: Genero!
  precio: Int!
  fecha_creacion: String!
  status: StatusObra!
  foto: String!
}

type Escultura {
  id_obra: ID!
  obra: Obra!
  material: String!
  peso: Int!
  dimensiones: String!
}

type Orden {
  id: ID!
  id_obra: ID!
  obra: Obra!
  id_cliente: ID!
  cliente: Cliente!
  id_trabajador: ID!
  trabajador: Trabajador!
  fecha: String!
  status: StatusOrden!
  direccion: String
}

type TarjetaCliente {
  id_tarjeta: ID!
  id_cliente: ID!
  cliente: Cliente!
  numero_tarjeta: String!
  tipo: String!
}

type Preguntas {
  id: ID!
  id_cliente: ID!
  cliente: Cliente!
  pregunta: String!
  respuesta: String!
}

type Membresia {
  id_membresia: ID!
  id_cliente: ID!
  cliente: Cliente!
  id_tarjeta: ID!
  tarjeta: TarjetaCliente!
  fecha: String!
}

type LoginResponseCliente {
  success: Boolean!
  id: ID
  nombre: String
}

type LoginResponseTrabajador {
  success: Boolean!
  id: ID
  nombre: String
  admin: Boolean
}

type ArtistaGenero {
  id_artista: ID!
  artista: Artista!
  id_genero: ID!
  genero: Genero!
}

# Input Types
input NewCliente {
  nombre: String!
  email: String!
  telefono: String!
  login: String!
  password: String!
  codigo_seguridad: String!
}

input UpdateCliente {
  id: ID!
  nombre: String
  email: String
  telefono: String
  login: String
  password: String
  codigo_seguridad: String
}

input NewTrabajador {
  nombre: String!
  login: String!
  password: String!
  admin: Boolean!
}

input UpdateTrabajador {
  id: ID!
  nombre: String
  login: String
  password: String
  admin: Boolean
}

input NewArtista {
  nombre: String!
  fecha_nacimiento: String!
  nacionalidad: String!
  biografia: String!
  foto: String!
}

input UpdateArtista {
  id: ID!
  nombre: String
  fecha_nacimiento: String
  nacionalidad: String
  biografia: String
  foto: String
}

input NewGenero {
  nombre: String!
}

input UpdateGenero {
  id: ID!
  nombre: String
}

input NewObra {
  nombre: String!
  id_artista: ID!
  id_genero: ID!
  precio: Int!
  fecha_creacion: String!
  status: StatusObra!
  foto: String!
}

input UpdateObra {
  id: ID!
  nombre: String
  id_artista: ID
  id_genero: ID
  precio: Int
  fecha_creacion: String
  status: StatusObra
  foto: String
}

input NewEscultura {
  id_obra: ID!
  material: String!
  peso: Int!
  dimensiones: String!
}

input UpdateEscultura {
  id_obra: ID!
  material: String
  peso: Int
  dimensiones: String
}

input NewOrden {
  id_obra: ID!
  id_cliente: ID!
  id_trabajador: ID
  fecha: String!
  status: StatusOrden!
  direccion: String
}

input UpdateOrden {
  id: ID!
  id_obra: ID
  id_cliente: ID
  id_trabajador: ID
  fecha: String
  status: StatusOrden
  direccion: String
}

input NewTarjetaCliente {
  id_cliente: ID!
  numero_tarjeta: String!
  tipo: String!
}

input UpdateTarjetaCliente {
  id_tarjeta: ID!
  id_cliente: ID
  numero_tarjeta: String
  tipo: String
}

input NewPreguntas {
  id_cliente: ID!
  pregunta: String!
  respuesta: String!
}

input UpdatePreguntas {
  id: ID!
  id_cliente: ID
  pregunta: String
  respuesta: String
}

input NewMembresia {
  id_cliente: ID!
  id_tarjeta: ID!
  fecha: String!
}

input UpdateMembresia {
  id_membresia: ID!
  id_cliente: ID
  id_tarjeta: ID
  fecha: String
}

input NewArtistaGenero {
  id_artista: ID!
  id_genero: ID!
}

input UpdateArtistaGenero {
  id_artista: ID!
  id_genero: ID!
  nuevo_id_artista: ID
  nuevo_id_genero: ID
}

type FacturaHistorica {
  periodo: String!
  fecha_factura: String!
  id_orden: ID!
  id_cliente: ID!
  cliente_nombre: String!
  id_obra: ID!
  obra_nombre: String!
  precio: Float!
  iva: Float!
  total: Float!
  ganancia_museo: Float!
}

type BitacoraObra {
  id_obra: ID!
  fecha_evento: String!
  id_evento: ID!
  tipo_evento: String!
  descripcion: String!
  usuario_responsable: String!
  estatus_anterior: String!
  estatus_nuevo: String!
}

# Inputs para registrar eventos desde el Backend
input NewBitacoraObra {
  id_obra: ID!
  tipo_evento: String!
  descripcion: String!
  usuario_responsable: String!
  estatus_anterior: String!
  estatus_nuevo: String!
}

# Queries
type Query {
  Clientes(limit: Int, offset: Int): [Cliente!]!
  Artistas(limit: Int, offset: Int): [Artista!]!
  Trabajadores(limit: Int, offset: Int): [Trabajador!]!
  Obras(limit: Int, offset: Int): [Obra!]!
  ObrasPorPrecio(limit: Int, offset: Int): [Obra!]!
  ObrasPorPrecioDesc(limit: Int, offset: Int): [Obra!]!
  ObrasPorGenero(idGenero: Int, limit: Int, offset: Int): [Obra!]!
  ObrasPorDisponibilidad(limit: Int, offset: Int): [Obra!]!
  Ordenes(limit: Int, offset: Int): [Orden!]!
  TarjetasCliente(limit: Int, offset: Int): [TarjetaCliente!]!
  Preguntas(limit: Int, offset: Int): [Preguntas!]!
  Membresias(limit: Int, offset: Int): [Membresia!]!
  Genero(limit: Int, offset: Int): [Genero!]!
  ArtistaGenero(limit: Int, offset: Int): [ArtistaGenero!]!
  Esculturas(limit: Int, offset: Int): [Escultura!]!
  findEscultura(id_obra: ID!): Escultura
  FindArtistaGeneroByArtista(id_artista: ID!): [ArtistaGenero!]!
  FindArtistaGeneroByGenero(id_genero: ID!): [ArtistaGenero!]!
  FindGenero(id: ID!): [Genero!]!
  findMembresia(id_membresia: ID!): Membresia
  findMembresiasByCliente(id_cliente: ID!): [Membresia!]!
  findMembresiasByTarjeta(id_tarjeta: ID!): [Membresia!]!
  findPreguntas(id: ID!): Preguntas
  findPreguntasByCliente(id_cliente: ID!): [Preguntas!]!
  findTarjetaCliente(id_tarjeta: ID!): TarjetaCliente
  findCliente(id: ID!): [Cliente!]!
  findTrabajador(id: ID!): [Trabajador!]!
  findObra(id: ID!): [Obra!]!
  findOrden(id: ID!): Orden
  findArtista(id: ID!): [Artista!]!
  getObra(id: ID!): Obra
  loginCliente(login: String!, password: String!): LoginResponseCliente!
  loginTrabajador(login: String!, password: String!): LoginResponseTrabajador!
  obtenerRecomendaciones(idCliente: ID!): [Obra!]!


  # Consulta masiva de reportes financieros por periodo (Ej: "2026-05")
  obtenerReporteFacturas(periodo: String!): [FacturaHistorica!]!
  
  # Consulta de auditoría inmutable de una obra por su ID
  obtenerBitacoraObra(id_obra: ID!): [BitacoraObra!]!
}

# Mutations
type Mutation {
  createCliente(input: NewCliente!): Cliente!
  updateCliente(input: UpdateCliente!): Cliente!
  killCliente(id: ID!): Boolean!

  createTrabajador(input: NewTrabajador!): Trabajador!
  updateTrabajador(input: UpdateTrabajador!): Trabajador!
  killTrabajador(id: ID!): Boolean!

  createArtista(input: NewArtista!): Artista!
  updateArtista(input: UpdateArtista!): Artista!
  killArtista(id: ID!): Boolean!

  createGenero(nombre: String!): Genero!
  updateGenero(input: UpdateGenero!): Genero!
  killGenero(id: ID!): Boolean!

  createObra(input: NewObra!): Obra!
  updateObra(input: UpdateObra!): Obra!
  killObra(id: ID!): Boolean!
  generarObrasMasivas(cantidad: Int!): String!
  llenarAtributosEsculturasMasivas: String!
  SincronizarFotosImgBBMasivo: String!

  createOrden(input: NewOrden!): Orden!
  updateOrden(input: UpdateOrden!): Orden!
  killOrden(id: ID!): Boolean!

  createTarjetaCliente(input: NewTarjetaCliente!): TarjetaCliente!
  updateTarjetaCliente(input: UpdateTarjetaCliente!): TarjetaCliente!
  killTarjetaCliente(id_tarjeta: ID!): Boolean!

  createPreguntas(input: NewPreguntas!): Preguntas!
  updatePreguntas(input: UpdatePreguntas!): Preguntas!
  killPreguntas(id: ID!): Boolean!

  createMembresia(input: NewMembresia!): Membresia!
  updateMembresia(input: UpdateMembresia!): Membresia!
  killMembresia(id_membresia: ID!): Boolean!

  createArtistaGenero(input: NewArtistaGenero!): ArtistaGenero!
  updateArtistaGenero(input: UpdateArtistaGenero!): ArtistaGenero!
  killArtistaGenero(id_artista: ID!, id_genero: ID!): Boolean!

  createEscultura(input: NewEscultura!): Escultura!
  updateEscultura(input: UpdateEscultura!): Escultura!

  # Registra manualmente una factura en Cassandra desnormalizando los datos
  emitirFacturaHistorica(
    periodo: String!
    fecha_factura: String!
    id_orden: ID!
    id_cliente: ID!
    cliente_nombre: String!
    id_obra: ID!
    obra_nombre: String!
    precio: Float!
  ): FacturaHistorica!

  # Registra un evento inmutable en la bitacora de seguridad/estatus
  registrarEventoObra(input: NewBitacoraObra!): BitacoraObra!
}